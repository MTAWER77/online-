{
  "name": "nova-ai",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // KV بدون id: wrangler بيعمله لوحده أول مرة تنشر. بيخزّن عدّاد الرسايل في السيرفر.
  "kv_namespaces": [
    { "binding": "AUTH" }
  ],
  "vars": {
    "FREE_LIMIT": "4",
    "FREE_PERIOD": "total"
    // ACTIVATION_CODE و SESSION_SECRET لازم يتحطوا كـ Secrets (wrangler secret put) - مش هنا.
  }
}
