{
  "name": "nova-ai",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // KV بدون id: wrangler بيعمله لوحده أول مرة تنشر. بيخزّن عدّاد الرسايل في السيرفر.
  "kv_namespaces": [
    { "binding": "AUTH" }
  ],
  "vars": {
    "FREE_LIMIT": "4",
    "FREE_PERIOD": "total",
    // كود التفعيل (تقدر تحط أكتر من كود مفصولين بفاصلة). بيتكتب في الإعدادات ويشيل الحد.
    // مؤقت: غيّره بعدين، وما ترفعش الملف ده على GitHub عام.
    "ACTIVATION_CODE": "NOVA-KNJF-5UCE-LXBE",
    "SESSION_SECRET": "o0D6NqlpcsN70Ov72Uww54POkzn8TNMS6oEmagkFgeNImmaD-meByQ"
  }
}
